# ═══════════════════════════════════════
# SafeGuard AI — Environment Configuration Example
# ═══════════════════════════════════════
# Copy this file to .env and configure as needed.

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=safeguard-ai-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Model
MODEL_PATH=best.onnx
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
VIOLATION_IOU_THRESHOLD=0.3
NUM_CLASSES=4
CLASS_NAMES=Face Mask,Helmet,Person,Safety Vest

# Database
DATABASE_URL=sqlite:///./safeguard.db

# ─────────────────────────────────────
# EMAIL ALERTS (OPTIONAL)
# ─────────────────────────────────────
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=recipient_email@gmail.com
EMAIL_COOLDOWN_SECONDS=30

# ─────────────────────────────────────
# WHATSAPP ALERTS (OPTIONAL)
# ─────────────────────────────────────
ENABLE_WHATSAPP_ALERTS=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=+14155238886
ALERT_WHATSAPP_TO=your_whatsapp_number
WHATSAPP_COOLDOWN_SECONDS=60

# Storage
SCREENSHOT_DIR=./screenshots

# ─────────────────────────────────────
# DEBUG RECEIVER (DEVELOPMENT ONLY)
# ─────────────────────────────────────
# When ALERT_DEBUG_MODE=true, alerts bypass SMTP/Twilio and are routed to a
# local aiosmtpd receiver that appends every message to DEBUG_LOG_FILE.
# Use this to verify the pipeline end-to-end without external accounts.
# NEVER set to true in production — alerts will silently never reach anyone.
ALERT_DEBUG_MODE=false
DEBUG_SMTP_HOST=127.0.0.1
DEBUG_SMTP_PORT=1025
DEBUG_LOG_FILE=./.alert-debug.log
