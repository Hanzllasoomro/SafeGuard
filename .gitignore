# ── Python/Backend Ignore ──
__pycache__/
*.py[cod]
*$py.class
*.db
*.sqlite
backend/safeguard.db
backend/.env
backend/screenshots/*
!backend/screenshots/.gitkeep
backend/temp/
backend/venv/
backend/.alert-debug.log

# ── Node/Frontend Ignore ──
node_modules/
package-lock.json
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.eslintcache
frontend/vite.config.js.timestamp-*.mjs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs/OS Ignore ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
.env
