{
  "name": "safeguard",
  "version": "1.0.0",
  "description": "SafeGuard AI \u2014 PPE Detection & Safety Compliance System",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "frontend": "cd frontend && npm run dev",
    "install:frontend": "cd frontend && npm install",
    "setup": "npm run install:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
